        <mxCell id="L180" value="recibe_key" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERoneToMany;endFill=1;startArrow=ERmandOne;startFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="E67" target="E143">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L181" value="aplica_key" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERoneToMany;endFill=1;startArrow=ERmandOne;startFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="E107" target="E143">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L182" value="aplica_key" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERoneToMany;endFill=1;startArrow=ERmandOne;startFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="E89" target="E143">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N183" value="&lt;b&gt;LEYENDA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria física (compuesta)&lt;br&gt;&lt;b&gt;AK&lt;/b&gt; llave surrogada de una columna — &lt;i&gt;pendiente&lt;/i&gt;, es la que Power BI necesita&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; clave foránea&lt;br&gt;&lt;b&gt;M&lt;/b&gt;&amp;nbsp;&amp;nbsp; medida aditiva&lt;br&gt;&lt;b&gt;DD&lt;/b&gt; dimensión degenerada&lt;br&gt;&lt;b&gt;!&lt;/b&gt;&amp;nbsp;&amp;nbsp; columna que cambia el resultado si la ignoras&lt;br&gt;&lt;br&gt;Azul = dimensión · Verde = hecho de transacción&lt;br&gt;Naranja = snapshot · Rojo = puente" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="N184" value="&lt;b&gt;CÓMO SE USA ESTE MODELO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Une las dimensiones de cliente por el SK&lt;/b&gt;, nunca por &lt;i&gt;cliente_id&lt;/i&gt;. &lt;i&gt;dim_cliente_comercial&lt;/i&gt; y &lt;i&gt;dim_cliente_credito&lt;/i&gt; son SCD2: unirlas por &lt;i&gt;cliente_id&lt;/i&gt; multiplica las filas por cada versión histórica, en silencio.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. &lt;i&gt;fact_pagos&lt;/i&gt; no es todo efectivo.&lt;/b&gt; Sumar &lt;i&gt;monto_moneda_local&lt;/i&gt; sin filtrar &lt;i&gt;tipo_linea = &#x27;VIRGEN&#x27; AND revertido = 0 AND es_reembolso = 0&lt;/i&gt; da un número ~3× mayor al real. Por eso se propone &lt;i&gt;monto_cobranza&lt;/i&gt;: vale 0 en las líneas que no son cobranza, y así &lt;i&gt;SUM()&lt;/i&gt; siempre da bien.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. La fecha que concilia contra SAP es &lt;i&gt;fecha_contabilizacion&lt;/i&gt;&lt;/b&gt;, no &lt;i&gt;fecha_documento&lt;/i&gt; ni &lt;i&gt;fecha_compensacion&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="340" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="N185" value="&lt;b&gt;fact_aplicacion ES UN PUENTE, NO UN HECHO DE REPORTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Está en rojo y con línea punteada a propósito. No se modela en Power BI junto a los demás: se usa solo para el detalle factura ↔ pago y para la cola de trabajo de Cobranza.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nunca sumes entre sus tres estatus&lt;/b&gt; — son tres promesas distintas:&lt;br&gt;· &lt;i&gt;IDENTIFICADA&lt;/i&gt; = esta factura&lt;br&gt;· &lt;i&gt;IDENTIFICADA_LOTE&lt;/i&gt; = una de estas ≤20 facturas&lt;br&gt;· &lt;i&gt;NO_IDENTIFICADA&lt;/i&gt; = no se sabe&lt;br&gt;&lt;br&gt;Y no sumes &lt;i&gt;monto_documento_recibe&lt;/i&gt; a este grano: se repite en cada fila. Lo único aditivo aquí es &lt;i&gt;monto_aplicado&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="1090" width="360" height="300" as="geometry" />
        </mxCell>
